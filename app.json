{
  "expo": {
    "name": "SteedMarket",
    "slug": "steed-market",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steedmarket.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "SteedMarket needs camera access to take horse listing photos.",
        "NSPhotoLibraryUsageDescription": "SteedMarket needs photo access to select horse listing images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.steedmarket.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d5c39185-dec5-4041-ba23-8dcca0f0586c"
      }
    }
  }
}
